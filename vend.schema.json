{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vend source descriptor",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "install": {
      "description": "Shell command(s) after clone or fresh checkout",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        {
          "type": "object",
          "properties": {
            "run": { "type": "string" },
            "script": { "type": "string" },
            "shell": { "type": "string" }
          }
        }
      ]
    },
    "update": {
      "description": "Shell command(s) after pull/consolidate when commit changed (defaults to install)"
    },
    "verify": {
      "description": "Optional check command (reserved for future verify hook)"
    }
  }
}
